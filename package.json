{
  "name": "@grace-studio/graceful-figma",
  "version": "3.0.0-beta.5",
  "description": "CLI that pulls SVGs from Figma into .svg files and React components",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "bin": {
    "graceful-figma": "./bin/index.js"
  },
  "files": [
    "bin/**/*",
    "lib/**/*"
  ],
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf ./lib",
    "build": "yarn clean && tsc -p tsconfig.build.json",
    "dev": "yarn build && node ./bin/index.js react-svgs",
    "prepack": "yarn build",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/grace-studio/graceful-figma.git"
  },
  "bugs": {
    "url": "https://github.com/grace-studio/graceful-figma/issues"
  },
  "keywords": [
    "figma",
    "icons",
    "svg",
    "react",
    "nextjs",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "6.0.1",
    "commander": "15.0.0",
    "inquirer": "14.2.5",
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
