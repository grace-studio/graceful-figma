{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "strict": true,
    "target": "ES2024",
    "module": "node16",
    "sourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "declaration": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
